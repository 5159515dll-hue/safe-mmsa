[Unit]
Description=SAFE-MMSA API (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/safe-mmsa
Environment=SAFEMMSA_STORAGE_DIR=/home/ubuntu/safe-mmsa/storage
Environment=SAFEMMSA_CORS_ORIGINS=*
# 真实模型就绪后取消下一行注释并指向 config，即自动挂载（其余零改动）：
# Environment=SAFEMMSA_MODELS_CONFIG=/home/ubuntu/safe-mmsa/models/config.example.json
ExecStart=/home/ubuntu/safe-mmsa/.venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8100
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
